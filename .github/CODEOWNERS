# .github/CODEOWNERS - RNIT example
#
# Each line is a path pattern followed by the reviewers GitHub requests
# automatically. The LAST matching line wins, so go general to specific.
#
# Combine with "Require review from Code Owners" in branch protection to make
# the right people mandatory reviewers instead of a naming convention nobody
# remembers.

# Default owner for everything
*                        @rnit/engineering

# Mobile
/android/                @rnit/mobile
/ios/                    @rnit/mobile
*.kt                     @rnit/mobile
*.swift                  @rnit/mobile

# Web
*.tsx                    @rnit/web
/src/app/                @rnit/web

# Backend
/src/modules/            @rnit/backend

# Anything that changes how code ships needs a lead. These are the files an
# attacker or a careless merge would target first.
/.github/workflows/      @rnit/leads
/.github/CODEOWNERS      @rnit/leads
.gitleaks.toml           @rnit/leads
/Dockerfile              @rnit/leads
